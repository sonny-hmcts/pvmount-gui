{
  "name": "pvmount-gui",
  "version": "0.1.0",
  "description": "macOS-first GUI for syncing Azure Key Vault secrets to the pvmount filesystem contract",
  "private": true,
  "author": "Sonny Lloyd",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run dev:clean && concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:clean": "rm -rf dist dist-electron",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 dist-electron/main/index.js dist-electron/preload/index.js dist-electron/shared/ipc.js dist-electron/shared/types.js && nodemon --watch dist-electron --ext js --exec \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "package": "npm run build && electron-builder --mac dmg pkg --publish never",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "uk.gov.hmcts.pvmount.gui",
    "productName": "PVMount GUI",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "pkg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    },
    "pkg": {
      "allowAnywhere": true,
      "allowCurrentUserHome": true,
      "allowRootDirectory": false
    }
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "wait-on": "^8.0.3"
  }
}
